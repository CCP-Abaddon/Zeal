{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Zeal (Release|x86)",
      "type": "shell",
      "command": "${workspaceFolder}\\.vscode\\build.bat",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        },
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
